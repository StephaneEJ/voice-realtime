{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main + overlay windows",
  "windows": ["main", "overlay"],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "obsidian://*" },
        { "url": "file://*" },
        { "url": "https://*" },
        { "url": "http://*" }
      ]
    },
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "global-shortcut:allow-is-registered",
    "fs:allow-write-text-file",
    "fs:allow-read-text-file",
    "fs:allow-exists",
    "fs:allow-read-dir",
    "fs:allow-remove",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$HOME/OBSIDIAN/2ND_CERVEAU/_System/voice-personas" },
        { "path": "$HOME/OBSIDIAN/2ND_CERVEAU/_System/voice-personas/*" },
        { "path": "$HOME/OBSIDIAN/2ND_CERVEAU" },
        { "path": "$HOME/OBSIDIAN/2ND_CERVEAU/**" }
      ]
    }
  ]
}
