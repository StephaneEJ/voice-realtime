{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "voice-realtime",
  "version": "0.1.0",
  "identifier": "com.stephanedufresne.voicert",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "voice-realtime",
        "width": 480,
        "height": 720,
        "minWidth": 360,
        "minHeight": 480,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "resizable": true,
        "alwaysOnTop": false,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ws://127.0.0.1:7711 ws://localhost:1420 http://localhost:1420; style-src 'self' 'unsafe-inline'; img-src 'self' data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
