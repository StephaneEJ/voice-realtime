{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "voice-realtime",
  "version": "0.1.0",
  "identifier": "com.stephanedufresne.voicert",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "voice-realtime",
        "width": 480,
        "height": 720,
        "minWidth": 360,
        "minHeight": 480,
        "visible": true,
        "decorations": true,
        "transparent": false,
        "skipTaskbar": false,
        "resizable": true,
        "alwaysOnTop": false,
        "hiddenTitle": false,
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
